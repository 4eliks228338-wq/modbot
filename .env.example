# Токен вашего Discord бота (получить на https://discord.com/developers/applications)
DISCORD_TOKEN=ваш_токен_бота_здесь

# ID модераторов/администраторов через запятую, которым бот будет отправлять алерты в ЛС
# Пример: 123456789012345678,987654321098765432
MODERATOR_USER_IDS=

# (Опционально) ID роли модератора (если хотите слать алерты всем с этой ролью)
MODERATOR_ROLE_ID=

# (Опционально) ID канала на сервере для дублирования алертов в модераторский чат
REPORT_CHANNEL_ID=

# Ключевые слова названий каналов из правил
POLITICS_CHANNEL=дискуссии-не-самых-умных
FLOOD_CHANNEL=деревенский-туалет
